# .env.example — copy to .env and fill in real values. Never commit the real .env.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017
DB_NAME=ai_study_companion

# JWT signing secret — use a long random string in any real deployment
JWT_SECRET=change-me-to-a-random-secret

# Groq API key for LLM calls (https://console.groq.com)
GROQ_API_KEY=

# Local storage paths
UPLOAD_DIR=uploads
CHROMA_DIR=chroma_store
